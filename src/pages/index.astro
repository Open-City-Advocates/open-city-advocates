---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE_DESCRIPTION } from "../lib/site";

// The homepage text lives in content/_index.md.
const home = await getEntry("pages", "_index");
if (!home) throw new Error("content/_index.md is missing");
const { Content } = await render(home);
const { mission, vision, description } = home.data;
---
<Base path="/" description={description}>
<section class="hero" style="background-image: linear-gradient(rgba(45,40,36,.52), rgba(45,40,36,.62)), url('/images/hero.webp');">
  <div class="wrap hero-inner">
    <h1 class="hero-title">Mission</h1>
    <p class="hero-mission">{mission || SITE_DESCRIPTION}</p>
  </div>
</section>

<section class="video-section">
  <div class="wrap">
    <div class="video-embed">
      <iframe src="https://www.youtube-nocookie.com/embed/oAz_uYa4SlM" title="20 Years of Open City Advocates" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
    </div>
  </div>
</section>

<div class="wrap prose home-prose">
  <Content />
</div>

<section class="vision-section">
  <div class="wrap vision-grid">
    <div class="vision-text">
      <h2>Vision</h2>
      <p>{vision}</p>
      <a class="btn btn-solid" href="/our-team">Meet The Team →</a>
    </div>
    <div class="vision-photo">
      <img src="/images/team-courtroom.jpeg" alt="The Open City Advocates team" loading="lazy" />
    </div>
  </div>
</section>
</Base>
