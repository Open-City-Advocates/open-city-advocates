---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { DONATE_URL, SITE_DESCRIPTION } from "../lib/site";

// The homepage text lives in content/_index.md.
const home = await getEntry("pages", "_index");
if (!home) throw new Error("content/_index.md is missing");
const { Content } = await render(home);
const { mission, vision, description } = home.data;
---
<Base path="/" description={description}>
<section class="hero" style="background-image: url('/images/hero.jpg');">
  <div class="hero-inner">
    <h1>Mission</h1>
    <p class="hero-mission">{mission || SITE_DESCRIPTION}</p>
  </div>
</section>

<section class="home-cols">
  <div class="home-prose">
    <Content />
  </div>
  <div class="home-video">
    <iframe src="https://www.youtube-nocookie.com/embed/oAz_uYa4SlM" title="20 Years of Open City Advocates" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
  </div>
</section>

<nav class="home-band" aria-label="Latest news, donate, and the annual report">
  <a class="band-link" href="/news-updates"><img src="/images/home-latest-news.png" alt="Latest News" width="1000" height="667" loading="lazy" /></a>
  <a class="band-link" href={DONATE_URL} target="_blank" rel="noopener"><img src="/images/home-donate-now.png" alt="Donate Now" width="1000" height="667" loading="lazy" /></a>
  <a class="band-link" href="/news-updates/our-2025-annual-report"><img src="/images/home-2025-annual-report.png" alt="2025 Annual Report" width="1000" height="667" loading="lazy" /></a>
</nav>

<section class="vision">
  <div>
    <h2>Vision</h2>
    <p>{vision}</p>
    <a class="btn-outline" href="/our-team">Meet The Team →</a>
  </div>
  <img src="/images/team-courtroom.jpeg" alt="The Open City Advocates team" width="2048" height="1536" loading="lazy" />
</section>
</Base>
