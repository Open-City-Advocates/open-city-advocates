---
// Every page except the homepage, laid out as the Squarespace site laid it out:
// news list and posts, team bios, Our Team, the Defense Guide, the report page,
// the centered Join Us pages, Mission & Values, and the Policy & Advocacy archive.
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import RequestAccessForm from "../components/RequestAccessForm.astro";
import {
  byDateDesc,
  findPage,
  isSection,
  isoDate,
  numericDate,
  pageUrl,
  pages,
  postDate,
  sectionOf,
  sectionPages,
  shortDate,
  shortName,
  type Page,
} from "../lib/site";

export async function getStaticPaths() {
  const all = await pages();
  return all
    .filter((page) => page.id !== "_index")
    .filter((page) => !page.data.href) // archive entries that link elsewhere
    .map((page) => ({ params: { slug: pageUrl(page).slice(1) }, props: { page, all } }));
}

interface Props {
  page: Page;
  all: Page[];
}

const { page, all } = Astro.props;
const { Content } = await render(page);
const data = page.data;
const path = pageUrl(page);
const section = sectionOf(page);

const REPORT = "/a-call-to-expand-post-disposition-representation-of-youth-in-the-juvenile-legal-system";
const GUIDE = "/post-disposition-defense-guide";
const APPLY = "/apply-for-access-to-the-post-disposition-defense-manual";

const kind = isSection(page)
  ? section === "policy-advocacy"
    ? "policy-list"
    : section === "news-updates"
      ? "news-list"
      : "narrow"
  : data.layout === "our-team"
    ? "our-team"
    : section === "policy-advocacy"
      ? "policy-single"
      : section === "news-updates"
        ? "post"
        : data.role
          ? "bio"
          : section === "join-us"
            ? "posting"
            : path === REPORT
              ? "report"
              : path === GUIDE
                ? "guide"
                : path === "/missions-and-values"
                  ? "aside"
                  : "plain";

// Section lists: newest first.
const children = isSection(page) ? byDateDesc(sectionPages(all, section)) : [];

// News posts: the newer and older posts, for the links under the post.
const posts = kind === "post" ? byDateDesc(sectionPages(all, "news-updates")) : [];
const at = posts.findIndex((post) => post.id === page.id);
const newer = at > 0 ? posts[at - 1] : undefined;
const older = at >= 0 && at < posts.length - 1 ? posts[at + 1] : undefined;

// Policy & Advocacy archive: grouped by year, newest year first.
const years = new Map<string, Page[]>();
if (kind === "policy-list") {
  for (const doc of children) {
    const year = String(doc.data.date?.getUTCFullYear() ?? "");
    if (!years.has(year)) years.set(year, []);
    years.get(year)!.push(doc);
  }
}

// Our Team: staff and board, resolved to their bio pages.
const staff = (data.staff ?? []).map((url) => findPage(all, url)).filter((bio): bio is Page => Boolean(bio));
const board = (data.board ?? []).map((url) => findPage(all, url)).filter((bio): bio is Page => Boolean(bio));

const title = kind === "bio" ? shortName(data.title) : data.title;
const ogType = isSection(page) ? "website" : "article";
---
<Base title={title} description={data.description} path={path} ogType={ogType}>
{kind === "post" && (
  <>
    <article class="post">
      <h1 class="post-title">{data.title}</h1>
      {data.date && <time class="post-date" datetime={isoDate(data.date)}>{postDate(data.date)}</time>}
      <div class="post-body"><Content /></div>
    </article>
    {(newer || older) && (
      <nav class="post-nav" aria-label="More news">
        {newer && (
          <a class="prev" href={pageUrl(newer)}>
            <svg viewBox="0 0 14 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 12l10 10"/></svg>
            <span>{newer.data.title}</span>
          </a>
        )}
        {older && (
          <a class="next" href={pageUrl(older)}>
            <span>{older.data.title}</span>
            <svg viewBox="0 0 14 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 2l10 10L2 22"/></svg>
          </a>
        )}
      </nav>
    )}
  </>
)}

{kind === "bio" && (
  <article class:list={["bio", { "no-photo": !data.photo }]}>
    <header class="bio-head">
      <p class="bio-role">{data.role}</p>
      <h1 class="bio-name">{title}</h1>
    </header>
    <div class="bio-text"><Content /></div>
    {data.photo && (
      <div class="bio-photo"><img src={`/${data.photo.replace(/^\//, "")}`} alt={title} width="400" height="500" /></div>
    )}
    {data.role !== "Board Member" && <div class="bio-form"><ContactForm name={title} /></div>}
    <p class="bio-actions"><a class="btn-solid" href="/our-team">Visit Other Team Bios →</a></p>
  </article>
)}

{kind === "our-team" && (
  <div class="team">
    <h1>{data.title}</h1>
    <ul class="team-list" role="list">
      {staff.map((bio) => (
        <li><a href={pageUrl(bio)}>{bio.data.title}{bio.data.role && <> | <em>{bio.data.role}</em></>}</a></li>
      ))}
    </ul>
    <h2 id="board-of-directors">Board of Directors</h2>
    <ul class="team-list" role="list">
      {board.map((bio) => <li><a href={pageUrl(bio)}>{shortName(bio.data.title)}</a></li>)}
    </ul>
  </div>
)}

{kind === "news-list" && (
  <>
    <h1 class="sr-only">{data.title}</h1>
    <ul class="news-list" role="list">
      {children.map((post) => (
        <li class="news-item">
          {post.data.image ? (
            <a class="news-thumb" href={pageUrl(post)} tabindex="-1" aria-hidden="true">
              <img src={`/${post.data.image.replace(/^\//, "")}`} alt="" loading="lazy" />
            </a>
          ) : <span />}
          <div class="news-body">
            {post.data.date && <time class="news-date" datetime={isoDate(post.data.date)}>{numericDate(post.data.date)}</time>}
            <h2 class="news-title"><a href={pageUrl(post)}>{post.data.title}</a></h2>
            <a class="news-more" href={pageUrl(post)}>Read More</a>
          </div>
        </li>
      ))}
    </ul>
  </>
)}

{kind === "narrow" && (
  <div class="narrow">
    <h1 class="sr-only">{data.title}</h1>
    <Content />
  </div>
)}

{kind === "posting" && (
  <div class="narrow posting">
    <h1 class="sr-only">{data.title}</h1>
    <Content />
  </div>
)}

{kind === "aside" && (
  <div class="aside-page auto">
    <h1 class="sr-only">{data.title}</h1>
    <Content />
  </div>
)}

{kind === "guide" && (
  <div class="aside-page">
    <h1>{data.title}</h1>
    <div class="aside-body">
      <Content />
      <RequestAccessForm />
    </div>
  </div>
)}

{kind === "report" && (
  <div class="report">
    <h1>{data.title}</h1>
    <div class="report-body"><Content /></div>
  </div>
)}

{kind === "plain" && (
  <div class="plain">
    <h1>{data.title}</h1>
    <Content />
    {path === APPLY && <RequestAccessForm />}
  </div>
)}

{kind === "policy-list" && (
  <>
    <section class="archive-hero">
      <h1>{data.title}</h1>
      {page.body?.trim() && <div class="lede"><Content /></div>}
    </section>

    <div class="archive">
      {[...years].map(([year, docs]) => (
        <section class="year-group">
          <div class="year-head">
            <span class="yr">{year}</span>
            <span class="yc">{docs.length} item{docs.length > 1 ? "s" : ""}</span>
          </div>
          {docs.map((doc) => (
            <a
              class="doc-row"
              href={doc.data.href ? doc.data.href.replace(/(.)\/$/, "$1") : pageUrl(doc)}
              target={doc.data.href ? "_blank" : undefined}
              rel={doc.data.href ? "noopener" : undefined}
            >
              <div class="ddate">{doc.data.docdate ?? (doc.data.date ? shortDate(doc.data.date) : "")}</div>
              <div class="dmeta">
                <div class="dttl">{doc.data.title}</div>
                {doc.data.by && <div class="dby">{doc.data.by}</div>}
                <div class="dtags"><span class="dtag type">{doc.data.doctype}</span>{doc.data.tags.map((tag) => <span class="dtag">{tag}</span>)}</div>
              </div>
              <div class="dgo">Read &rarr;</div>
            </a>
          ))}
        </section>
      ))}
    </div>
  </>
)}

{kind === "policy-single" && (
  <article class="document">
    <p class="eyebrow">{data.doctype}{data.docdate && ` · ${data.docdate}`}</p>
    <h1>{data.title}</h1>
    {data.by && <p class="doc-by">{data.by}</p>}
    {data.tags.length > 0 && <div class="dtags">{data.tags.map((tag) => <span class="dtag">{tag}</span>)}</div>}

    <Content />

    <div class="cite-note">
      <p>Free to quote and share with attribution.</p>
      <p class="back-link"><a href="/policy-advocacy">&larr; Back to Policy &amp; Advocacy</a></p>
    </div>
  </article>
)}
</Base>
