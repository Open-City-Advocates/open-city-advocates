---
// The contact form each staff bio carried on the Squarespace site. There is no
// form server here: on submit, the browser's email app opens with the message
// addressed to CONTACT.email (see Base.astro).
import { CONTACT } from "../lib/site";

interface Props {
  name: string;
}
const { name } = Astro.props;
---
<form class="sq-form" method="post" action={`mailto:${CONTACT.email}`} data-mailto={CONTACT.email} data-subject={`Message for ${name}`}>
  <div class="field">
    <label class="title" for="contact-email">Email <span class="required">(required)</span></label>
    <input type="email" id="contact-email" name="Email" required autocomplete="email" />
  </div>
  <label class="option"><input type="checkbox" name="Sign up for news and updates" value="Yes" /> Sign up for news and updates</label>
  <div class="field">
    <label class="title" for="contact-message">Message <span class="required">(required)</span></label>
    <textarea id="contact-message" name="Message" required></textarea>
  </div>
  <div class="submit-row"><button class="submit" type="submit">Submit</button></div>
  <p class="form-note">Submitting opens your email app with the message addressed to {CONTACT.email}.</p>
</form>
