---
import { CONTACT, DONATE_URL, SUBSCRIBE_URL } from "../lib/site";
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand-col">
      <img class="footer-logo" src="/images/logo-reversed.png" alt="Open City Advocates" width="253" height="50" />
      <address class="footer-contact">
        {CONTACT.address}<br />
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        <span aria-hidden="true"> · </span>
        <a href={`tel:${CONTACT.phone.replaceAll("-", "")}`}>{CONTACT.phone}</a>
      </address>
      <p class="footer-note">Open City Advocates is a 501(c)(3) organization.</p>
    </div>

    <nav class="footer-col" aria-label="Explore">
      <h2 class="footer-heading">Explore</h2>
      <ul class="footer-links">
        <li><a href="/">About Us</a></li>
        <li><a href="/our-team">Our Team</a></li>
        <li><a href="/news-updates">News &amp; Updates</a></li>
        <li><a href="/policy-advocacy">Policy &amp; Advocacy</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Resources">
      <h2 class="footer-heading">Resources</h2>
      <ul class="footer-links">
        <li><a href="/post-disposition-defense-guide">Post-Disposition Defense Guide</a></li>
        <li><a href="/a-call-to-expand-post-disposition-representation-of-youth-in-the-juvenile-legal-system">A Call to Expand Post-Disposition Representation</a></li>
      </ul>
    </nav>

    <div class="footer-col footer-actions-col">
      <h2 class="footer-heading">Get Involved</h2>
      <ul class="footer-links">
        <li><a href={SUBSCRIBE_URL}>Subscribe for Email Updates</a></li>
        <li><a href="/join-us">Join Us</a></li>
        <li><a class="footer-donate" href={DONATE_URL}>Donate</a></li>
      </ul>
      <ul class="footer-social" aria-label="Social media">
        <li><a href="https://www.facebook.com/opencityadvocates" aria-label="Open City Advocates on Facebook" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.24 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.24 22 17.08 22 12.06Z"/></svg>
        </a></li>
        <li><a href="https://x.com/opencityadv" aria-label="Open City Advocates on X" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="currentColor"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.2-6.81-5.96 6.81H1.7l7.73-8.84L1.25 2.25h6.82l4.71 6.23 5.46-6.23Zm-1.16 17.52h1.83L7.03 4.13H5.06L17.08 19.77Z"/></svg>
        </a></li>
        <li><a href="https://www.linkedin.com/company/open-city-advocates" aria-label="Open City Advocates on LinkedIn" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z"/></svg>
        </a></li>
      </ul>
    </div>
  </div>
</footer>
