---
import { DONATE_URL, MENU, SUBSCRIBE_URL } from "../lib/site";

interface Props {
  // The current page's path, to mark its menu item active.
  path: string;
}

const { path } = Astro.props;
const submenuId = (name: string) => `submenu-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Open City Advocates — home">
      <img src="/images/logo.png" alt="Open City Advocates" width="253" height="50" />
    </a>
    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">Menu</button>
    <nav class="site-nav" aria-label="Primary">
      <ul class="nav-list">
        {MENU.map((item) =>
          item.children ? (
            <li class="has-children">
              <button type="button" class="nav-parent" aria-expanded="false" aria-controls={submenuId(item.name)}>{item.name}</button>
              <ul class="submenu" id={submenuId(item.name)}>
                {item.children.map((child) => <li><a href={child.url}>{child.name}</a></li>)}
              </ul>
            </li>
          ) : (
            <li><a href={item.url} class={item.url === path ? "active" : undefined}>{item.name}</a></li>
          )
        )}
        <li><a href={SUBSCRIBE_URL}>Subscribe</a></li>
        <li><a class="nav-donate" href={DONATE_URL}>Donate</a></li>
      </ul>
    </nav>
  </div>
</header>
